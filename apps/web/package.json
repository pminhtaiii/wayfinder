    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.379.0",
    "maplibre-gl": "^5.24.0",
    "next": "14.2.3",
    "next-auth": "^4.24.7",
    "postcss": "^8.4.38",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-map-gl": "^8.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^4.0.0-alpha.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.14.0",
    "@playwright/test": "1.62.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "typescript": "^5.4.5"
  }
