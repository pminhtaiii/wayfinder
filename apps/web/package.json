{
  "name": "@web/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "check:routes": "node scripts/check-route-files.mjs",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --config=tests/playwright.config.ts",
    "test:unit": "node scripts/run-node-tests.mjs unit",
    "test:route-contracts": "node scripts/run-node-tests.mjs routes",
    "test:node": "node scripts/run-node-tests.mjs all",
    "test:interface": "node scripts/run-playwright.mjs interface",
    "test:characterization": "pnpm test:interface",
    "test:system": "node scripts/run-playwright.mjs system",
    "test:compatibility": "tsx --test lib/server/flight-search.spec.ts lib/server/booking-management.spec.ts tests/handoff-checkout-proxy.unit.ts tests/supplier-identity-injection.unit.ts"
  },
  "dependencies": {
    "@shared/types": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0-alpha.1",
    "@turf/great-circle": "^7.3.5",
