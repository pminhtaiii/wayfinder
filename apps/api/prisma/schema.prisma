datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BookingIntentStatus {
  PENDING
  EXPIRED
  COMPLETED
  AWAITING_PAYMENT
  PAYMENT_EXHAUSTED
  CONFIRMED
  CANCELLED
}

enum AncillaryStatus {
  EMPTY
  DRAFT_COMMITTED
  VALIDATED
  STALE
}

enum AncillarySelectionStatus {
  DRAFT_COMMITTED
  VALIDATED
  STALE
  PAYMENT_BOUND
}

enum BaggageType {
  CHECKED
  CARRY_ON
}

enum WeightUnit {
  KG
  LB
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  password         String
  role             UserRole         @default(USER)
  status           UserStatus       @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastLogin        DateTime?
  auditLogs        AuditLog[]
  chatSessions     ChatSession[]
  travelerProfile  TravelerProfile?
  bookings         Booking[]
  bookingIntents   BookingIntent[]
  searchHistory    SearchHistory[]
  stripeCustomerId String?          @unique
  idempotencyKeys  IdempotencyKey[]
  refundsTriggered Refund[]
  paymentMethods   PaymentMethod[]
  chatHandoffs     ChatHandoff[]

  @@map("users")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resourceType  String
  resourceId    String?
  metadata      Json
  traceId       String
  correlationId String
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

enum MessageSender {
  USER
  AGENT
}

enum MessageType {
  STANDARD
  SUMMARY
}

model ChatSession {
  id              String        @id @default(uuid())
  userId          String
  titleCiphertext String?
  titleNonce      String?
  titleAuthTag    String?
  titleKeyVersion Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastActiveAt    DateTime      @default(now())
  deletedAt       DateTime?
  messages        ChatMessage[]
  handoffs        ChatHandoff[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastActiveAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id                String        @id @default(uuid())
  sessionId         String
  sender            MessageSender
  type              MessageType   @default(STANDARD)
  contentCiphertext String?
  contentNonce      String?
  contentAuthTag    String?
  contentKeyVersion Int?
  createdAt         DateTime      @default(now())
  session           ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@index([sessionId, type])
  @@map("chat_messages")
}

/// TravelerProfile holds user travel preferences and sensitive travel identity documents.
/// All sensitive PII fields (like passportNumber and passportExpiry) are encrypted
/// at the application level using AES-256-GCM before storage to comply with GDPR requirements.
model TravelerProfile {
  id                       String                   @id @default(uuid())
  userId                   String                   @unique
  seatPreference           String?
  classPreference          String?
  preferredAirlines        String[]
  blacklistedAirlines      String[]
  preferredDepartureWindow Json?
  preferredArrivalWindow   Json?
  maxStops                 Int?
  priceSensitivity         String?
  requiresCheckedBaggage   Boolean?
  dietaryNeeds             String?
  nationality              String?
  /// @encrypted
  /// Sensitive PII. Encrypted at the application layer using AES-256-GCM before database insertion.
  passportNumber           String?
  /// @encrypted
  /// Sensitive PII. Encrypted/tokenized at the application layer to comply with GDPR data protection requirements.
  passportExpiry           DateTime?
  givenName                String?
  middleName               String?
  familyName               String?
  dateOfBirth              DateTime?                @db.Date
  gender                   String?
  title                    String?
  email                    String?
  phoneCountryCode         String?
  phoneNumber              String?
  documentType             String?
  issuingCountry           String?                  @db.VarChar(2)
  passportExpiryCiphertext String?
  revision                 Int                      @default(1)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingIntentPassengers  BookingIntentPassenger[]

  @@map("traveler_profiles")
}

/// Stores flight booking records.
/// NOTE: Booking stores currency amounts (totalAmount, airlineRefundAmount, customerRefundAmount) in major currency units (DECIMAL(10,2), e.g. 100.50).
/// In contrast, Refund stores currency amounts in minor currency units (integer cents, e.g. 10050).
/// Always use explicit unit conversions (Math.round(amount * 100) when converting major to minor units, or amount / 100 when converting minor to major units) when mapping between Booking and Refund.
model Booking {
  id                        String                @id @default(uuid())
  userId                    String
  bookingIntentId           String                @unique
  paymentId                 String?               @unique
  status                    BookingStatus         @default(PROCESSING)
  failureReason             BookingFailureReason?
  pnrReference              String?
  supplierOrderId           String?
  flightSnapshot            Json?
  passengerSnapshot         Json?
  totalAmount               Decimal               @db.Decimal(10, 2)
  currency                  String                @default("GBP")
  departureAt               DateTime?
  cancellationDeadline      DateTime?
  cancellationRefundable    Boolean               @default(false)
  airlineRefundAmount       Decimal?              @db.Decimal(10, 2)
  customerRefundAmount      Decimal?              @db.Decimal(10, 2)
  supplierCancellationQuoteId String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  version                   Int                   @default(1)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingIntent      BookingIntent @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)
  payment            Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  cancellationRefundObligation CancellationRefundObligation?

  disruptionStatus           DisruptionStatus           @default(NONE)
  activeDisruptionRevisionId String?                    @unique
  syncLockedAt               DateTime?
  syncLockToken              String?
  lastSupplierSyncedAt       DateTime?
  nextSupplierSyncAt         DateTime?
  currentDepartureAt         DateTime?
  nextUnflownDepartureAt     DateTime?
  currentFinalArrivalAt      DateTime?
  disruptionResolvedReason   DisruptionResolvedReason?
  disruptionResolvedAt       DateTime?
  disruptionResolvedByType   DisruptionActorType?
  disruptionResolvedById     String?
  disruptionNeedsAttention   Boolean                    @default(false)
  disruptionAttentionReason  DisruptionAttentionReason?
  disruptionAttentionAt      DateTime?

  itineraryRevisions       ItineraryRevision[]     @relation("BookingItineraryRevisions")
  activeDisruptionRevision ItineraryRevision?      @relation("BookingActiveDisruptionRevision", fields: [activeDisruptionRevisionId], references: [id], onDelete: SetNull)
  notificationOutbox       NotificationOutbox[]    @relation("BookingNotificationOutbox")
  disruptionAuditEvents    DisruptionAuditEvent[]  @relation("BookingDisruptionAuditEvents")
  agentProjection          BookingAgentProjection?
  fulfillmentWorkflow      FulfillmentWorkflow? @relation("FulfillmentWorkflowBooking")

  @@index([userId])
  @@index([userId, status])
  @@index([departureAt])
  @@index([status, createdAt])
  @@index([status, departureAt])
  @@index([supplierOrderId])
  @@index([status, nextUnflownDepartureAt, lastSupplierSyncedAt])
  @@index([disruptionStatus, disruptionResolvedAt])
  @@index([disruptionNeedsAttention, disruptionAttentionAt])
  @@index([syncLockedAt])
  @@map("bookings")
}

model BookingIntent {
  id                          String                   @id @default(uuid())
  userId                      String
  flightOfferId               String?
  supplierOfferId             String
  status                      BookingIntentStatus      @default(PENDING)
  originalPrice               Decimal                  @db.Decimal(10, 2)
  confirmedPrice              Decimal                  @db.Decimal(10, 2)
  currency                    String                   @default("USD")
  priceChanged                Boolean                  @default(false)
  pricedAt                    DateTime
  origin                      String                   @db.VarChar(3)
  destination                 String                   @db.VarChar(3)
  departureDate               DateTime                 @db.Date
  returnDate                  DateTime?                @db.Date
  cabinClass                  String                   @default("economy")
  adults                      Int
  children                    Int                      @default(0)
  infants                     Int                      @default(0)
  rawOfferSnapshot            Json
  intentExpiresAt             DateTime
  offerExpiresAt              DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  user                        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flightOffer                 FlightOffer?             @relation(fields: [flightOfferId], references: [id], onDelete: SetNull)
  passengers                  BookingIntentPassenger[]
  paymentAttemptCount         Int                      @default(0)
  payments                    Payment[]
  booking                     Booking?
  fulfillmentWorkflow         FulfillmentWorkflow?
  ancillaryVersion            Int                      @default(0)
  currentAncillarySelectionId String?                  @unique
  currentAncillarySelection   AncillarySelection?      @relation("BookingIntentCurrentAncillarySelection", fields: [currentAncillarySelectionId], references: [id], onDelete: SetNull)
  ancillarySelections         AncillarySelection[]     @relation("BookingIntentAncillarySelections")
  ancillaryStatus             AncillaryStatus          @default(EMPTY)
  ancillaryCurrency           String?                  @db.VarChar(3)
  seatTotal                   Decimal                  @default(0) @db.Decimal(10, 2)
  baggageTotal                Decimal                  @default(0) @db.Decimal(10, 2)
  ancillaryTotal              Decimal                  @default(0) @db.Decimal(10, 2)
  validatedTotal              Decimal?                 @db.Decimal(10, 2)
  ancillariesValidatedAt      DateTime?
  chatHandoff                 ChatHandoff?

  @@index([userId])
  @@index([userId, status])
  @@index([status, intentExpiresAt])
  @@index([status, updatedAt])
  @@map("booking_intents")
}

model BookingIntentPassenger {
  id                String           @id @default(uuid())
  intentId          String
  position          Int
  type              PassengerType
  givenName         String
  familyName        String
  dateOfBirth       DateTime         @db.Date
  gender            String
  nationality       String?          @db.VarChar(2)
  /// @encrypted
  passportNumber    String?
  /// @encrypted
  passportExpiry    String?
  travelerProfileId String?
  supplierPassengerId String?
  middleName        String?
  title             String?
  email             String?
  phoneCountryCode  String?
  phoneNumber       String?
  documentType      String?
  issuingCountry    String?          @db.VarChar(2)
  snapshotVersion   Int              @default(1)
  createdAt         DateTime         @default(now())
  intent            BookingIntent    @relation(fields: [intentId], references: [id], onDelete: Cascade)
  travelerProfile   TravelerProfile? @relation(fields: [travelerProfileId], references: [id], onDelete: SetNull)

  @@unique([intentId, position])
  @@index([intentId])
  @@index([travelerProfileId])
  @@index([intentId, supplierPassengerId])
  @@map("booking_intent_passengers")
}

model AncillarySelection {
  id                       String                   @id @default(uuid())
  bookingIntentId          String
  version                  Int
  status                   AncillarySelectionStatus @default(DRAFT_COMMITTED)
  currency                 String                   @db.VarChar(3)
  seatTotal                Decimal                  @db.Decimal(10, 2)
  baggageTotal             Decimal                  @db.Decimal(10, 2)
  total                    Decimal                  @db.Decimal(10, 2)
  catalogFingerprint       String
  committedAt              DateTime                 @default(now())
  validatedBaseAmount      Decimal?                 @db.Decimal(10, 2)
  validatedGrandTotal      Decimal?                 @db.Decimal(10, 2)
  validatedAt              DateTime?
  validationLeaseToken     String?
  validationLeaseExpiresAt DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  bookingIntent            BookingIntent            @relation("BookingIntentAncillarySelections", fields: [bookingIntentId], references: [id], onDelete: Cascade)
  currentForIntent         BookingIntent?           @relation("BookingIntentCurrentAncillarySelection")
  seatSelections           SeatSelection[]
  baggageSelections        BaggageSelection[]
  payments                 Payment[]                @relation("PaymentAncillarySelection")

  @@unique([bookingIntentId, version])
  @@unique([id, bookingIntentId, version])
  @@index([bookingIntentId])
  @@index([validationLeaseExpiresAt])
  @@map("ancillary_selections")
}

model SeatSelection {
  id                   String             @id @default(uuid())
  ancillarySelectionId String
  intentPassengerId    String
  supplierPassengerId   String
  segmentId            String
  serviceId            String
  seatDesignator       String
  amount               Decimal            @db.Decimal(10, 2)
  currency             String             @db.VarChar(3)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  ancillarySelection   AncillarySelection @relation(fields: [ancillarySelectionId], references: [id], onDelete: Cascade)

  @@unique([ancillarySelectionId, intentPassengerId, segmentId])
  @@unique([ancillarySelectionId, segmentId, serviceId])
  @@map("seat_selections")
}

model BaggageSelection {
  id                   String                    @id @default(uuid())
  ancillarySelectionId String
  intentPassengerId    String
  supplierPassengerId   String
  serviceId            String
  type                 BaggageType
  weightValue          Int?
  weightUnit           WeightUnit?
  quantity             Int
  amount               Decimal                   @db.Decimal(10, 2)
  currency             String                    @db.VarChar(3)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  ancillarySelection   AncillarySelection        @relation(fields: [ancillarySelectionId], references: [id], onDelete: Cascade)
  segments             BaggageSelectionSegment[]

  @@unique([ancillarySelectionId, intentPassengerId, serviceId])
  @@map("baggage_selections")
}

model BaggageSelectionSegment {
  baggageSelectionId String
  segmentId          String
  baggageSelection   BaggageSelection @relation(fields: [baggageSelectionId], references: [id], onDelete: Cascade)

  @@id([baggageSelectionId, segmentId])
  @@map("baggage_selection_segments")
}

enum BookingStatus {
  PROCESSING
  CONFIRMED
  FAILED
  COMPLETED
  CANCELLATION_PENDING
  CANCELLED_PENDING_REFUND
  CANCELLED_AND_REFUNDED
  CANCELLED_NO_REFUND
  REFUND_FAILED_NEEDS_ATTENTION
}

enum BookingFailureReason {
  OFFER_EXPIRED
  PRICE_CHANGED
  BOOKING_TIMEOUT
  CAPTURE_FAILED
  SYSTEM_ERROR
}

enum AirportType {
  LARGE_AIRPORT
  MEDIUM_AIRPORT
}

model Airport {
  id        String      @id @default(cuid())
  iataCode  String      @unique @db.VarChar(3)
  icaoCode  String?     @db.VarChar(4)
  name      String
  city      String
  country   String      @db.VarChar(2)
  region    String?
  latitude  Float
  longitude Float
  elevation Int?
  type      AirportType
  timezone  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([country])
  @@index([icaoCode])
  @@index([latitude, longitude])
  @@index([name])
  @@map("airports")
}

model FlightOffer {
  id             String          @id @default(uuid())
  searchHash     String
  supplierOfferId String
  rawOffer       Json
  origin         String          @db.VarChar(3)
  destination    String          @db.VarChar(3)
  departureDate  DateTime        @db.Date
  returnDate     DateTime?       @db.Date
  adults         Int
  children       Int             @default(0)
  infants        Int             @default(0)
  cabinClass     String          @default("economy") @map("cabin_class")
  price          Decimal         @db.Decimal(10, 2)
  currency       String          @default("USD")
  createdAt      DateTime        @default(now())
  bookingIntents BookingIntent[]
  chatHandoffs   ChatHandoff[]

  @@unique([searchHash, supplierOfferId])
  @@index([searchHash])
  @@index([createdAt])
  @@map("flight_offers")
}

model SearchHistory {
  id            String    @id @default(uuid())
  userId        String
  origin        String    @db.VarChar(3)
  destination   String    @db.VarChar(3)
  departureDate DateTime  @db.Date
  returnDate    DateTime? @db.Date
  adults        Int
  children      Int       @default(0)
  infants       Int       @default(0)
  cabinClass    String    @default("economy") @map("cabin_class")
  resultCount   Int
  minPrice      Decimal?  @db.Decimal(10, 2)
  maxPrice      Decimal?  @db.Decimal(10, 2)
  currency      String    @default("USD")
  searchHash    String
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("search_history")
}

model OfferRecovery {
  id         String   @id // The offer UUID
  searchHash String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("offer_recoveries")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  CHARGEBACK_LOST
  RESERVED
}

enum RefundStatus {
  REFUND_PENDING
  REFUND_PROCESSING
  REFUND_RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  REFUND_FAILED_NEEDS_ATTENTION
}

enum RefundTriggerType {
  USER
  ADMIN
  SYSTEM_AUTOMATED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum PaymentEventSource {
  WEBHOOK
  API
  CRON
  SYSTEM
}

model Payment {
  id                        String              @id @default(uuid())
  bookingIntentId           String
  bookingIntent             BookingIntent       @relation(fields: [bookingIntentId], references: [id])
  fulfillmentWorkflowId     String?
  ancillarySelectionId      String?
  ancillarySelectionVersion Int?
  ancillarySelection        AncillarySelection? @relation("PaymentAncillarySelection", fields: [ancillarySelectionId, bookingIntentId, ancillarySelectionVersion], references: [id, bookingIntentId, version], onDelete: Restrict)
  attemptNumber             Int // 1 or 2 (Database-level CHECK constraint attemptNumber IN (1, 2) enforced in migration)
  idempotencyKeyId          String
  idempotencyKey            IdempotencyKey      @relation(fields: [idempotencyKeyId], references: [id])
  stripePaymentIntentId     String?             @unique
  stripeCustomerId          String?
  amount                    Int // smallest currency unit (cents)
  currency                  String // ISO 4217 (e.g., "usd")
  paymentMethodType         String? // e.g., "card"
  status                    PaymentStatus       @default(CREATED)
  preDisputeStatus          PaymentStatus? // populated when entering DISPUTED
  version                   Int                 @default(0) // optimistic locking
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  paymentEvents                  PaymentEvent[]
  fulfillmentWorkflow            FulfillmentWorkflow?  @relation("WorkflowPaymentAttempts", fields: [fulfillmentWorkflowId], references: [id], onDelete: SetNull)
  currentForWorkflows             FulfillmentWorkflow[] @relation("WorkflowCurrentPayment")
  providerOperations              ProviderOperation[]
  ledgerEntries                  LedgerEntry[]
  refunds                        Refund[]
  booking                        Booking?
  cancellationRefundObligations CancellationRefundObligation[]

  @@unique([bookingIntentId, attemptNumber])
  @@index([stripeCustomerId])
  @@index([status])
  @@index([ancillarySelectionId])
  @@index([fulfillmentWorkflowId])
  @@map("payments")
}

model IdempotencyKey {
  id            String    @id @default(uuid())
  key           String    @unique
  requestHash   String // SHA-256 of request body — catches key reuse with different payload
  customerId    String
  customer      User      @relation(fields: [customerId], references: [id])
  requestPath   String // API endpoint path
  requestParams Json? // request body snapshot
  responseCode  Int? // HTTP status code of cached response
  responseBody  Json? // cached response for replay
  recoveryPoint String    @default("started") // started → stripe_authorized → duffel_order_created → captured → completed
  lockedAt      DateTime? // claim mechanism for pessimistic lock
  createdAt     DateTime  @default(now())
  expiresAt     DateTime

  payments Payment[]
  refunds  Refund[]

  @@index([customerId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model PaymentEvent {
  id             BigInt             @id @default(autoincrement())
  paymentId      String
  payment        Payment            @relation(fields: [paymentId], references: [id])
  eventType      String // e.g., "payment_intent.succeeded", "refund.created"
  previousStatus PaymentStatus
  newStatus      PaymentStatus
  amount         Int? // amount involved in this event
  source         PaymentEventSource // WEBHOOK, API, CRON, SYSTEM
  stripeEventId  String?            @unique // webhook deduplication — nullable for non-webhook events
  metadata       Json? // raw payload
  providerOperationId String?
  providerAttemptId   String?
  provider            ProviderKind?
  evidenceKind        ProviderEvidenceKind?
  outcomeClass        ProviderOutcomeClass?
  bookingIntentMatched Boolean?
  offerMatched         Boolean?
  passengerSetMatched Boolean?
  itineraryMatched    Boolean?
  createdAt      DateTime           @default(now())
  createdBy      String // user ID, "system", or service name
  providerOperation ProviderOperation? @relation(fields: [providerOperationId], references: [id], onDelete: SetNull)
  providerAttempt   ProviderAttempt?   @relation(fields: [providerAttemptId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([providerOperationId])
  @@index([providerAttemptId])
  @@index([eventType])
  @@map("payment_events")
}

model LedgerEntry {
  id                  String          @id @default(uuid())
  paymentId           String
  payment             Payment         @relation(fields: [paymentId], references: [id])
  refundTransactionId String?
  refundTransaction   Refund?         @relation(fields: [refundTransactionId], references: [id], onDelete: SetNull)
  transactionId       String // groups paired debit/credit rows
  accountId           String // CUSTOMER_RECEIVABLE | PLATFORM_REVENUE | DUFFEL_COST
  entryType           LedgerEntryType // DEBIT or CREDIT
  amount              Int // smallest currency unit
  currency            String // ISO 4217
  createdAt           DateTime        @default(now())

  @@unique([refundTransactionId, accountId, entryType])
  @@index([paymentId])
  @@index([transactionId])
  @@index([accountId])
  @@index([refundTransactionId])
  @@map("ledger_entries")
}

model CancellationRefundObligation {
  id                  String   @id @default(uuid())
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId           String
  payment             Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  totalAmount         Int // minor units (cents), non-negative; total customer amount owed
  airlineRefundAmount Int // minor units (cents), non-negative; supplier refund quote amount
  currency            String   @default("GBP")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  refunds Refund[]

  @@index([paymentId])
  @@map("cancellation_refund_obligations")
}

/// Stores payment refund transactions.
/// NOTE: Refund stores currency amounts (amount, airlineRefundAmount, customerRefundAmount) in minor currency units (integer cents, e.g. 10050).
/// In contrast, Booking stores currency amounts in major currency units (DECIMAL(10,2), e.g. 100.50).
/// Always use explicit unit conversions (Math.round(amount * 100) when converting major to minor units, or amount / 100 when converting minor to major units) when mapping between Booking and Refund.
model Refund {
  id                             String                        @id @default(uuid())
  paymentId                      String
  payment                        Payment                       @relation(fields: [paymentId], references: [id])
  cancellationRefundObligationId String?
  cancellationRefundObligation   CancellationRefundObligation? @relation(fields: [cancellationRefundObligationId], references: [id], onDelete: SetNull)
  idempotencyKeyId               String
  idempotencyKey                 IdempotencyKey                @relation(fields: [idempotencyKeyId], references: [id])
  stripeRefundId                 String?                       @unique
  amount                         Int // smallest currency unit
  currency                       String // ISO 4217
  reason                         String?
  triggerType                    RefundTriggerType // USER, ADMIN, or SYSTEM_AUTOMATED
  triggeredByUserId              String? // NULL for automated refunds
  triggeredByUser                User?                         @relation(fields: [triggeredByUserId], references: [id])
  requiresReview                 Boolean                       @default(false) // flags automated refunds for 24h human check
  status                         RefundStatus                  @default(REFUND_PENDING)
  airlineRefundAmount            Int?
  customerRefundAmount           Int?
  retryCount                     Int                           @default(0)
  nextRetryAt                    DateTime?
  idempotencyKeyCreatedAt        DateTime?
  lastErrorCode                  String?
  lastErrorAt                    DateTime?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([idempotencyKeyId])
  @@index([paymentId])
  @@index([status])
  @@index([status, nextRetryAt])
  @@index([cancellationRefundObligationId])
  @@map("refunds")
}

model PaymentMethod {
  id                    String   @id @default(uuid())
  stripeCustomerId      String
  stripePaymentMethodId String   @unique
  cardBrand             String? // visa, mastercard, etc.
  cardLast4             String? // last 4 digits for display
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault             Boolean  @default(false)
  savedWithConsent      Boolean  @default(false) // only set to true through validated saveCard opt-in path
  createdAt             DateTime @default(now())

  @@index([stripeCustomerId])
  @@index([userId])
  @@map("payment_methods")
}

enum DisruptionStatus {
  NONE
  DETECTED
  ACKNOWLEDGED
  RESOLVED
}

enum DisruptionResolvedReason {
  TRAVELLER_ACCEPTED
  DEPARTURE_PASSED
  ADMIN_RESOLVED
  BOOKING_CANCELLED
}

enum DisruptionActorType {
  TRAVELLER
  SYSTEM
  ADMIN
}

enum DisruptionAttentionReason {
  NOTIFICATION_THROTTLED
  AGED_UNRESOLVED
  DATA_QUALITY
}

enum ItineraryRevisionSource {
  WEBHOOK
  RECONCILIATION
  BOOTSTRAP
}

enum MaterialBaseline {
  INCREMENTAL
  CUMULATIVE
}

enum MaterialDisruptionReason {
  SEGMENT_REMOVED
  SEGMENT_ADDED
  DEPARTURE_AIRPORT_CHANGED
  ARRIVAL_AIRPORT_CHANGED
  DEPARTURE_LOCAL_DATE_CHANGED
  ARRIVAL_LOCAL_DATE_CHANGED
  DEPARTURE_MOVED_EARLIER
  DEPARTURE_MOVED_LATER
  FINAL_ARRIVAL_MOVED_EARLIER
  FINAL_ARRIVAL_MOVED_LATER
