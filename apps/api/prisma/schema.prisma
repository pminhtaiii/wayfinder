enum DuffelWebhookEventStatus {
  PENDING
  PROCESSING
  RETRY_SCHEDULED
  PROCESSED
  SKIPPED
  FAILED_NEEDS_ATTENTION
}

enum NotificationOutboxType {
  MATERIAL_DISRUPTION
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum DisruptionAuditEventAction {
  DETECTED
  ACKNOWLEDGED
  TRAVELLER_ACCEPTED
  DEPARTURE_RESOLVED
  BOOKING_CANCELLED
  ADMIN_RESOLVED
  EVENT_RETRIED
  ATTENTION_RAISED
  ATTENTION_CLEARED
}

model ItineraryRevision {
  id                 String                     @id @default(uuid())
  bookingId          String
  version            Int
  source             ItineraryRevisionSource
  sourceEventId      String?
  supplierObservedAt DateTime?
  fingerprint        String
  isMaterial         Boolean
  materialReasons    MaterialDisruptionReason[]
  materialBaselines  MaterialBaseline[]
  incrementalDiff    Json
  cumulativeDiff     Json
  rulesetVersion     String                     @default("disruption-v1")
  createdAt          DateTime                   @default(now())

  booking               Booking                    @relation("BookingItineraryRevisions", fields: [bookingId], references: [id], onDelete: Cascade)
  activeForBooking      Booking?                   @relation("BookingActiveDisruptionRevision")
  segments              ItineraryRevisionSegment[] @relation("RevisionSegments")
  notificationOutbox    NotificationOutbox?        @relation("RevisionNotificationOutbox")
  disruptionAuditEvents DisruptionAuditEvent[]     @relation("RevisionDisruptionAuditEvents")

  @@unique([bookingId, version])
  @@index([bookingId, createdAt(sort: Desc)])
  @@index([bookingId, isMaterial, createdAt(sort: Desc)])
  @@index([sourceEventId])
  @@map("itinerary_revisions")
}

model ItineraryRevisionSegment {
  id                   String   @id @default(uuid())
  revisionId           String
  sliceOrder           Int
  segmentOrder         Int
  globalOrder          Int
  supplierSegmentId    String?
  marketingCarrierIata String
  operatingCarrierIata String?
  airlineName          String
  flightNumber         String
  departureAirportIata String
  departureAirportName String
  departureCity        String
  departureTerminal    String?
  departureAt          DateTime
  departureLocalDate   DateTime @db.Date
  arrivalAirportIata   String
  arrivalAirportName   String
  arrivalCity          String
  arrivalTerminal      String?
  arrivalAt            DateTime
  arrivalLocalDate     DateTime @db.Date
  durationMinutes      Int
  aircraftType         String?
  createdAt            DateTime @default(now())

  revision ItineraryRevision @relation("RevisionSegments", fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, globalOrder])
  @@index([revisionId, sliceOrder, segmentOrder])
  @@index([supplierSegmentId])
  @@map("itinerary_revision_segments")
}

model DuffelWebhookEvent {
  id                  String                   @id @default(uuid())
  supplierEventId     String                   @unique
  idempotencyKey      String?
  duffelOrderId       String?
  eventType           String
  status              DuffelWebhookEventStatus
  attempts            Int                      @default(0)
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  processingToken     String?
  rawPayload          Json?
  payloadRedactedAt   DateTime?
  lastErrorCode       String?
  lastErrorAt         DateTime?
  processedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([processingStartedAt])
  @@index([duffelOrderId, createdAt(sort: Desc)])
  @@index([payloadRedactedAt, createdAt])
  @@map("duffel_webhook_events")
}

model NotificationOutbox {
  id                   String                   @id @default(uuid())
  bookingId            String
  revisionId           String                   @unique
  type                 NotificationOutboxType
  status               NotificationOutboxStatus @default(PENDING)
  payload              Json
  stabilizationWarning Boolean                  @default(false)
  attempts             Int                      @default(0)
  deliveredAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  booking  Booking           @relation("BookingNotificationOutbox", fields: [bookingId], references: [id], onDelete: Cascade)
  revision ItineraryRevision @relation("RevisionNotificationOutbox", fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@map("notification_outbox")
}

model DisruptionAuditEvent {
  id            String                     @id @default(uuid())
  bookingId     String
  revisionId    String?
  action        DisruptionAuditEventAction
  fromStatus    DisruptionStatus?
  toStatus      DisruptionStatus?
  actorType     DisruptionActorType
  actorId       String?
  safeNote      String?
  correlationId String
  traceId       String
  createdAt     DateTime                   @default(now())

  booking  Booking            @relation("BookingDisruptionAuditEvents", fields: [bookingId], references: [id], onDelete: Cascade)
  revision ItineraryRevision? @relation("RevisionDisruptionAuditEvents", fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt(sort: Desc)])
  @@index([revisionId])
  @@index([action, createdAt])
  @@map("disruption_audit_events")
}

model BookingAgentProjection {
  bookingId       String   @id // Private one-to-one Booking relation
  agentReference  String   @unique
  status          String
  airline         String
  origin          String
  destination     String
  departureAt     DateTime
  arrivalAt       DateTime
  durationMinutes Int
  stopCount       Int
  flightNumber    String?
  baggageSummary  String?
  refundable      Boolean?
  changeable      Boolean?
  sourceVersion   Int      @default(0) @map("source_version")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_agent_projections")
}

model ChatHandoff {
  id                        String    @id @default(uuid())
  userId                    String
  chatSessionId             String
  flightOfferId             String
  supplierOfferIdHash       String
  snapshotVersion           Int
  snapshotFingerprint       String
  selectionAttestationHash  String
  selectedOfferIndex        Int
  tokenHash                 String    @unique
  tokenKeyVersion           Int
  idempotencyKeyHash        String    @unique
  expiresAt                 DateTime
  claimedAt                 DateTime?
  claimTokenHash            String?
  claimExpiresAt            DateTime?
  claimRecoverAfter         DateTime?
  consumedAt                DateTime?
  consumedByBookingIntentId String?   @unique
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession             ChatSession    @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  flightOffer             FlightOffer    @relation(fields: [flightOfferId], references: [id], onDelete: Restrict)
  consumedByBookingIntent BookingIntent? @relation(fields: [consumedByBookingIntentId], references: [id], onDelete: Restrict)

  @@index([userId, chatSessionId, expiresAt])
  @@index([flightOfferId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@index([claimExpiresAt, consumedAt])
  @@map("chat_handoffs")
}
enum FulfillmentWorkflowState {
  AUTHORIZING
  READY_FOR_SUPPLIER
  SUPPLIER_UNCERTAIN
  SUPPLIER_CONFIRMED
  CAPTURE_UNCERTAIN
  COMPENSATING
  COMPLETED
  DEFINITIVE_FAILURE
}

enum WorkflowActorType {
  SAGA
  RECOVERY
  OPERATOR
}

enum ProviderKind {
  STRIPE
  DUFFEL
}

enum ProviderEvidenceKind {
  HTTP_RESPONSE
  AUTHORITATIVE_READ
  WEBHOOK
  CANDIDATE_DISCOVERY
}

enum ProviderOutcomeClass {
  CONFIRMED
  DEFINITIVE_FAILURE
  NONFINAL
  UNRESOLVED
}

enum ProviderOperationPurpose {
  PAYMENT_INTENT_CREATE
  AUTHORIZATION
  ORDER_CREATE
  CAPTURE
  ORDER_CANCEL
  AUTHORIZATION_RELEASE
  REFUND
  RECONCILE
}

enum ProviderOperationStatus {
  NOT_STARTED
  PREPARED
  UNRESOLVED
  CONFIRMED
  DEFINITIVE_FAILURE
  COMPENSATED
}

enum ProviderAttemptKind {
  DISPATCH
  RECONCILIATION
}

enum ProviderAttemptStatus {
  PREPARED
  RESPONSE_RECEIVED
  CONFIRMED
  DEFINITIVE_FAILURE
  UNRESOLVED
  ABANDONED_BEFORE_DISPATCH
}

model FulfillmentWorkflow {
  id                String                   @id @default(uuid())
  bookingIntentId   String                   @unique
  bookingId         String?                  @unique
  currentPaymentId  String?
  state             FulfillmentWorkflowState @default(AUTHORIZING)
  currentCheckpoint String?
  version           Int                      @default(0)
  firstUncertainAt  DateTime?
  escalatedAt       DateTime?
  nextReconcileAt   DateTime?
  lastReconciledAt  DateTime?
  ownerToken        String?
  fence             BigInt                   @default(0)
  leaseExpiresAt    DateTime?
  renewedAt         DateTime?
  actorType         WorkflowActorType?
  actorId           String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  bookingIntent   BookingIntent @relation(fields: [bookingIntentId], references: [id], onDelete: Restrict)
  booking         Booking?      @relation("FulfillmentWorkflowBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  currentPayment  Payment?      @relation("WorkflowCurrentPayment", fields: [currentPaymentId], references: [id], onDelete: SetNull)
  paymentAttempts Payment[]     @relation("WorkflowPaymentAttempts")
  operations      ProviderOperation[]

  @@index([state, nextReconcileAt])
  @@index([firstUncertainAt])
  @@map("fulfillment_workflows")
}

model ProviderOperation {
  id               String                   @id @default(uuid())
  workflowId       String
  paymentId        String?
  provider         ProviderKind
  purpose          ProviderOperationPurpose
  logicalSequence  Int                      @default(1)
  status           ProviderOperationStatus  @default(NOT_STARTED)
  providerObjectId String?
  linkedOrderId    String?
  firstUncertainAt DateTime?
  lastOutcome      ProviderOutcomeClass?
  lastObservedAt   DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  workflow      FulfillmentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  attempts      ProviderAttempt[]
  paymentEvents PaymentEvent[]

  @@unique([workflowId, provider, purpose, logicalSequence])
  @@index([workflowId, status])
  @@index([paymentId])
  @@map("provider_operations")
}

model ProviderAttempt {
  id                    String                @id @default(uuid())
  operationId           String
  kind                  ProviderAttemptKind
  status                ProviderAttemptStatus @default(PREPARED)
  claimFence            BigInt
  startedAt             DateTime              @default(now())
  dispatchedAt          DateTime?
  completedAt           DateTime?
  providerRequestId     String?
  providerObjectId      String?
  requestFingerprint    String?
  normalizedFailureCode String?
  normalizedOutcome     ProviderOutcomeClass?
  createdAt             DateTime              @default(now())

  operation     ProviderOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  paymentEvents PaymentEvent[]

  @@index([operationId, startedAt])
  @@index([claimFence])
  @@map("provider_attempts")
}
