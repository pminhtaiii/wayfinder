{
  "name": "@api/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @shared/types build && prisma generate && nest build",
    "dev": "pnpm start:dev",
    "start": "nest start",
    "start:dev": "pnpm --filter @shared/types build && prisma generate && nest start --watch",
    "start:debug": "pnpm --filter @shared/types build && prisma generate && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"../../packages/shared/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "test:ci": "jest --config ./jest.config.json --runInBand",
    "test:unit": "jest --config ./jest-unit.json --runInBand",
    "test:contract": "jest --config ./jest-contract.json --runInBand",
    "test:component": "jest --config ./jest-component.json --runInBand",
    "test:integration": "jest --config ./jest-integration.json --runInBand",
    "test:performance:unit": "jest --config ./jest-performance-unit.json --runInBand",
    "test:performance": "jest --config ./jest-performance.json --runInBand",
    "test:partition": "node ./test/api-test-partition.contract.test.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:performance": "jest --config ./test/jest-e2e-performance.json --runInBand"
  },
  "dependencies": {
    "@duffel/api": "^4.28.0",
    "@langchain/core": "^0.2.3",
    "@langchain/openai": "^0.1.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^5.14.0",
    "@shared/types": "workspace:*",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.22.1",
    "ioredis": "^5.4.1",
    "langchain": "^0.2.2",
    "langsmith": "^0.1.68",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "stripe": "^15.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
