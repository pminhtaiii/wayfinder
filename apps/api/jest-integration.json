{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testMatch": [
    "**/src/payment-fulfillment/fulfillment-workflow.repository.spec.ts",
    "**/src/disruption/sync/supplier-sync.service.spec.ts",
    "**/test/**/*.e2e-spec.ts",
    "**/src/payment-fulfillment/provider-operation.service.spec.ts",
    "**/test/fulfillment-harness/scheduler.spec.ts",
    "**/test/fulfillment-harness/driver.spec.ts"
  ],
  "testPathIgnorePatterns": [
    "[.-]performance\\.e2e-spec\\.ts$",
    "supplier-order-module\\.e2e-spec\\.ts$",
    "supplier-order-services\\.e2e-spec\\.ts$",
    "supplier-ancillary\\.e2e-spec\\.ts$",
    "ancillary-catalog\\.e2e-spec\\.ts$",
    "payment-fulfillment-safety\\.e2e-spec\\.ts$"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@shared/(.*)$": "<rootDir>/../../packages/shared/src/$1"
  }
}
