{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testMatch": [
    "**/src/**/*.module.spec.ts",
    "**/src/**/*.adapter.spec.ts",
    "**/src/flights/flights-module-wiring.spec.ts",
    "**/test/supplier-order-module.e2e-spec.ts",
    "**/test/supplier-order-services.e2e-spec.ts",
    "**/test/supplier-ancillary.e2e-spec.ts",
    "**/test/ancillary-catalog.e2e-spec.ts",
    "**/test/payment-fulfillment-safety.e2e-spec.ts",
    "**/test/fulfillment-harness/provider-transports.spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@shared/(.*)$": "<rootDir>/../../packages/shared/src/$1"
  }
}
